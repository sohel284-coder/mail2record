SECRET_KEY=change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=mail2record_dev
DB_USER=mail2record_app
DB_PASSWORD=local-dev-password
DB_HOST=127.0.0.1
DB_PORT=5434
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

AI_PROVIDER=ollama
OLLAMA_MODEL=Qwen2.5:7B

# Encrypts stored mailbox credentials (OAuth tokens / IMAP app passwords).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_CREDENTIALS_KEY=
# IMAP works for every provider out of the box. Only flip this on after doing
# the Google Cloud setup in MAILBOX_SETUP.md — it shows the "Connect Gmail" button.
GMAIL_OAUTH_ENABLED=False
# Must match an Authorized redirect URI on the Google OAuth client:
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/emails/oauth/gmail/callback/
